// Gruvbox dark - Fastfetch
// {#NN} colors are 256-index codes mapping to kitty's gruvbox palette (0-15).
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "source": "pop_small",
        "color": {
            "1": "#fe8019",
            "2": "#fe8019",
            "3": "#fe8019",
            "4": "#fe8019"
        },
        "padding": {
            "top": 3
        }
    },
    "display": {
        "separator": " ",
        "color": "#928374"
    },
    "modules": [
        {
            "key": "╭───────────╮",
            "type": "custom"
        },
        {
            "key": "│ {#12} user    {#keys}│",
            "type": "title",
            "format": "{user-name}@{host-name}"
        },
        {
            "key": "│ {#10}󰅐 uptime  {#keys}│",
            "type": "uptime"
        },
        {
            "key": "│ {#3}{icon} distro  {#keys}│",
            "type": "os"
        },
        {
            "key": "│ {#13} kernel  {#keys}│",
            "type": "kernel"
        },
        {
            "key": "│ {#14} wm      {#keys}│",
            "type": "wm"
        },
        {
            "key": "│ {#11}󰇄 desktop {#keys}│",
            "type": "de"
        },
        {
            "key": "│ {#12} term    {#keys}│",
            "type": "terminal"
        },
        {
            "key": "│ {#10} shell   {#keys}│",
            "type": "shell"
        },
        {
            "key": "│ {#14}󰍛 cpu     {#keys}│",
            "type": "cpu",
            "showPeCoreCount": true
        },
        {
            "key": "│ {#13}󰉉 disk    {#keys}│",
            "type": "disk",
            "folders": "/"
        },
        {
            "key": "│ {#11} memory  {#keys}│",
            "type": "memory"
        },
        {
            "key": "│ {#3}󰍛 gpu     {#keys}│",
            "type": "gpu"
        },
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "key": "│ {#9} colors  {#keys}│",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "key": "╰───────────╯",
            "type": "custom"
        }
    ]
}
