# Gruvbox dark - Sway config for luca
# Palette: https://github.com/morhetz/gruvbox
# Kitty uses the same gruvbox dark palette

# ── Gruvbox dark palette ─────────────────────────────────────────
set $bg0 #282828
set $bg1 #3c3836
set $bg2 #504945
set $bg3 #665c54
set $bg4 #7c6f64
set $fg0 #fbf1c7
set $fg1 #ebdbb2
set $fg2 #d5c4a1
set $fg3 #bdae93
set $fg4 #a89984
set $gray #928374
set $red #fb4934
set $green #b8bb26
set $yellow #fabd2f
set $blue #83a598
set $purple #d3869b
set $aqua #8ec07c
set $orange #fe8019

### Variables
set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term kitty
set $browser brave-browser
set $menu fuzzel

include /etc/sway/config-vars.d/*

### Appearance ─────────────────────────────────────────────────────
# gaps & borders (mocha aesthetic) - smaller again
gaps inner 6
gaps outer 2
smart_gaps off
smart_borders off
default_border pixel 2
default_floating_border pixel 2
title_align center
font pango:CaskaydiaCove NF 10

# Rounded corners + blur - swayfx
corner_radius 10
smart_corner_radius on
# window blur (frosted behind semi-transparent windows) - stronger for visibility
blur enable
blur_xray disable
blur_passes 3
blur_radius 8
blur_noise 0.02
blur_brightness 0.95
blur_contrast 0.95
blur_saturation 1.1
layer_effects "waybar" blur enable; shadows enable; corner_radius 12
layer_effects "fuzzel" blur enable; shadows enable; corner_radius 12
layer_effects "swaync-notification-window" blur enable; blur_ignore_transparent enable; shadows enable; corner_radius 10
layer_effects "swaync-control-center" blur enable; blur_ignore_transparent enable; shadows enable; corner_radius 10
layer_effects "quick-settings" blur enable; blur_ignore_transparent enable; shadows enable; corner_radius 12
layer_effects "logo-menu" blur disable; shadows enable; corner_radius 16
# shadows
shadows enable
shadow_blur_radius 15
shadow_color #282828CC
# window open/close animations - swayfx 0.6 (built from source Sep 2026, PR #487)
animation_duration_ms 150

# window colors (gruvbox dark)
#    target                 title      bg     text    indicator   border
client.focused              $gray      $bg0   $fg0    $gray       $gray
client.focused_inactive     $bg2       $bg0   $fg1    $gray       $bg2
client.unfocused            $bg1       $bg0   $fg2    $gray       $bg1
client.urgent               $red       $bg0   $red    $bg1        $red
client.placeholder          $bg2       $bg0   $fg1    $bg2        $bg2
client.background           $bg0

# blur for other apps - make windows slightly transparent so swayfx blur shows behind (kitty already 0.75 via kitty.conf)
for_window [app_id=".*"] opacity 0.92
for_window [app_id="brave-browser"] opacity 0.92
# disable blur on maximized (floating) Win+m windows - opaque, no frosted background
for_window [floating] blur disable
for_window [floating] opacity 1

# shadows / rounding handled by compositor - sway is minimal here

### Output
# keep your wallpaper, fallback to mocha solid color
output * bg #282828 solid_color
output * bg /home/luca/Downloads/gruv-portal-cake.png fill
# Example: output HDMI-A-1 resolution 1920x1080 position 1920,0

### Idle - hyprshade OLED mimic: dim + blue-light + suspend
# blue-light filter (hyprshade oled) - disabled by default, Win+Shift+g to toggle
# exec gammastep -O 3500 &
# burn-in prevention: dim screen after 5min, then suspend after 15min
exec swayidle -w \
         timeout 300 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
         timeout 900 'swaylock -f --color 282828 --inside-color 282828 --ring-color fe8019 --key-hl-color fabd2f --line-color 00000000 --separator-color 00000000 --text-color ebdbb2 --inside-ver-color 83a598 --ring-ver-color 83a598 --inside-wrong-color fb4934 --ring-wrong-color fb4934 --inside-clear-color b8bb26 --ring-clear-color b8bb26 --bs-hl-color fb4934 & systemctl suspend' \
         before-sleep 'swaylock -f --color 282828 --inside-color 282828 --ring-color fe8019 --key-hl-color fabd2f --line-color 00000000 --separator-color 00000000 --text-color ebdbb2 --inside-ver-color 83a598 --ring-ver-color 83a598 --inside-wrong-color fb4934 --ring-wrong-color fb4934 --inside-clear-color b8bb26 --ring-clear-color b8bb26 --bs-hl-color fb4934'

# Lid close - lock + suspend (requires swayidle before-sleep already locks, this ensures immediate)
bindswitch lid:on exec swaylock -f --color 282828 --inside-color 282828 --ring-color fe8019 --key-hl-color fabd2f --line-color 00000000 --separator-color 00000000 --text-color ebdbb2 --inside-ver-color 83a598 --ring-ver-color 83a598 --inside-wrong-color fb4934 --ring-wrong-color fb4934 --inside-clear-color b8bb26 --ring-clear-color b8bb26 --bs-hl-color fb4934 & systemctl suspend

### Focus - Hyprland-like dwindle (halve again + cursor side)
focus_follows_mouse yes
focus_on_window_activation focus
mouse_warping container
# autotiling: no limit (-l 0) = halve forever, split where cursor focuses
exec $HOME/.local/bin/autotiling

### Autostart - notifications (swaync) - Catppuccin Mocha + XDG autostart
exec swaync
exec swaync-client --reload-config 2>/dev/null; swaync-client --reload-css 2>/dev/null
exec sh -c 'export PATH="$HOME/.local/share/nvm/v24.18.0/bin:$PATH"; export GI_TYPELIB_PATH="/usr/local/lib/x86_64-linux-gnu/girepository-1.0"; export LD_LIBRARY_PATH="/usr/local/lib/x86_64-linux-gnu"; exec ags run'
exec dex --autostart --environment sway
# Fix mic not detected - card was on output:analog-stereo (no input), need duplex
exec pactl set-card-profile alsa_card.pci-0000_00_1f.3 output:analog-stereo+input:analog-stereo
exec pactl set-source-mute alsa_input.pci-0000_00_1f.3.analog-stereo false
exec pactl set-source-volume alsa_input.pci-0000_00_1f.3.analog-stereo 80%

### Cursor - Catppuccin Mocha Dark (matches sway mocha)
seat seat0 xcursor_theme phinger-cursors-dark 24

### Input ──────────────────────────────────────────────────────────
# QWERTZ + Trackpad richtig rum
input type:keyboard {
    xkb_layout de
    xkb_options lv3:ralt_switch,compose:rctrl
}

input type:touchpad {
    natural_scroll enabled
    tap enabled
    dwt disabled
    middle_emulation enabled
}

input "2:8:AlpsPS/2_ALPS_DualPoint_Stick" {
    natural_scroll enabled
}

input "2:8:AlpsPS/2_ALPS_DualPoint_TouchPad" {
    natural_scroll enabled
}

### Key bindings ───────────────────────────────────────────────────
# Basics:
    # Terminal (kitty - already themed Catppuccin-Macchiato)
    bindsym $mod+t exec $term
    bindsym $mod+Return exec $term
    bindsym $mod+z exec flatpak run com.rtosta.zapzap

    # Browser (brave) - Win+b primary, Win+o fallback
    bindsym $mod+b exec $browser
    bindsym $mod+o exec $browser
    bindsym $mod+Shift+o exec $browser --incognito

    # Settings - Win+i (GNOME Control Center, needs GNOME env under sway)
    bindsym $mod+i exec env XDG_CURRENT_DESKTOP=GNOME gnome-control-center

    # Vesktop (discord) - Win+v
    bindsym $mod+v exec vesktop

    # Kill service via fuzzel + sudo pkill - Win+p (INSECURE - see script)
    bindsym $mod+p exec ~/.local/bin/fuzzel-kill.sh

    # Kill focused window
    bindsym $mod+q kill

    # Lock screen - Win+Esc (Catppuccin Mocha)
    bindsym $mod+Escape exec swaylock -f --color 282828 --inside-color 282828 --ring-color fe8019 --key-hl-color fabd2f --line-color 00000000 --separator-color 00000000 --text-color ebdbb2 --inside-ver-color 83a598 --ring-ver-color 83a598 --inside-wrong-color fb4934 --ring-wrong-color fb4934 --inside-clear-color b8bb26 --ring-clear-color b8bb26 --bs-hl-color fb4934

    # Notifications - swaync (installed, now themed mocha)
    bindsym $mod+n exec swaync-client -t -sw
    bindsym $mod+Shift+n exec swaync-client -d -sw

    # Blue-light toggle (hyprshade oled) - Win+Shift+g
    bindsym $mod+Shift+g exec /home/luca/.local/bin/toggle-blue.sh

    # Screenshot - Win+Shift+s (area to clipboard like Windows Snipping Tool) - uses grim+slurp directly to avoid grimshot->sway dependency with swayfx
    bindsym $mod+Shift+s exec grim -g "$(slurp -d)" - | wl-copy && notify-send -a sway "Screenshot" "Area copied to clipboard"
    bindsym $mod+Shift+a exec mkdir -p ~/Pictures && grim -g "$(slurp -d)" ~/Pictures/screenshot-$(date +%Y-%m-%d-%H%M%S).png && notify-send -a sway "Screenshot" "Saved to ~/Pictures"

    # Launcher - tap Super alone (not Super+combo)
    bindsym --release Super_L exec $menu
    bindsym --release Super_R exec $menu

    # Launcher - categorized (custom categories)
    bindsym $mod+c exec /home/luca/.local/bin/fuzzel-categorized.sh
    # Fallback launcher on Mod+d (like fuzzel)
    bindsym $mod+d exec $menu
    # Plain drun fallback (uncategorized) via Shift
    bindsym $mod+Shift+d exec fuzzel --prompt "Apps: "
    # Win+x - fuzzel bash input, no suggestions, no terminal
    bindsym $mod+x exec ~/.local/bin/fuzzel-run.sh

    # Drag floating windows
    floating_modifier $mod normal

    # Reload the configuration file
    bindsym $mod+Shift+c reload

    # Exit sway - moved from Win+Shift+e to Win+Shift+q (Win+e now Thunar)
    bindsym $mod+Shift+q exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'

# Moving around:
    bindsym $mod+$left focus left
    bindsym $mod+$down focus down
    bindsym $mod+$up focus up
    bindsym $mod+$right focus right
    bindsym $mod+Left focus left
    bindsym $mod+Down focus down
    bindsym $mod+Up focus up
    bindsym $mod+Right focus right

    bindsym $mod+Shift+$left move left
    bindsym $mod+Shift+$down move down
    bindsym $mod+Shift+$up move up
    bindsym $mod+Shift+$right move right
    bindsym $mod+Shift+Left move left
    bindsym $mod+Shift+Down move down
    bindsym $mod+Shift+Up move up
    bindsym $mod+Shift+Right move right

# Workspaces:
    bindsym $mod+1 workspace number 1
    bindsym $mod+2 workspace number 2
    bindsym $mod+3 workspace number 3
    bindsym $mod+4 workspace number 4
    bindsym $mod+5 workspace number 5
    bindsym $mod+6 workspace number 6
    bindsym $mod+7 workspace number 7
    bindsym $mod+8 workspace number 8
    bindsym $mod+9 workspace number 9
    bindsym $mod+0 workspace number 10
    bindsym $mod+Shift+1 move container to workspace number 1
    bindsym $mod+Shift+2 move container to workspace number 2
    bindsym $mod+Shift+3 move container to workspace number 3
    bindsym $mod+Shift+4 move container to workspace number 4
    bindsym $mod+Shift+5 move container to workspace number 5
    bindsym $mod+Shift+6 move container to workspace number 6
    bindsym $mod+Shift+7 move container to workspace number 7
    bindsym $mod+Shift+8 move container to workspace number 8
    bindsym $mod+Shift+9 move container to workspace number 9
    bindsym $mod+Shift+0 move container to workspace number 10

# Layout: splith/splitv moved to Shift (Win+b/v now for apps)
    bindsym $mod+Shift+b splith
    bindsym $mod+Shift+v splitv
    bindsym $mod+s layout stacking
    bindsym $mod+w layout tabbed
    bindsym $mod+Shift+e layout toggle split
    bindsym $mod+f fullscreen
    bindsym $mod+F11 fullscreen toggle
    # Win+e = Thunar (Windows Explorer) - moved layout toggle to Shift+e
    bindsym $mod+e exec thunar
    # Win+m = maximize like titlebar square (Windows-like, keeps gaps/bar)
    bindsym $mod+m exec ~/.local/bin/sway-maximize.sh
    bindsym $mod+Shift+space floating toggle
    bindsym $mod+space focus mode_toggle
    bindsym $mod+a focus parent

# Scratchpad:
    bindsym $mod+Shift+minus move scratchpad
    bindsym $mod+minus scratchpad show

# Resizing containers:
mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# Media / volume (optional, mocha friendly) — with tick after change
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5% && paplay /usr/share/sounds/freedesktop/stereo/audio-volume-change.oga
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5% && paplay /usr/share/sounds/freedesktop/stereo/audio-volume-change.oga
bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle && paplay /usr/share/sounds/freedesktop/stereo/audio-volume-change.oga
bindsym XF86AudioMicMute exec pamixer --default-source --toggle-mute 2>/dev/null || wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle 2>/dev/null; paplay /usr/share/sounds/freedesktop/stereo/audio-volume-change.oga; notify-send -a sway "Mic" "$(pamixer --default-source --get-mute 2>/dev/null | grep -q true && echo muted || echo unmuted)"
bindsym XF86MonBrightnessUp exec brightnessctl set +5%
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym $mod+period exec ags request logo-menu

