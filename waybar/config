{
    "layer": "top",
    "position": "top",
    "spacing": 4,
    "height": 38,
    "margin": "8px 8px 0 8px",
    "modules-left": [
        "custom/logo",
        "sway/workspaces",
        "custom/weather",
        "custom/media"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "custom/keyboard",
        "tray",
        "custom/timer",
        "network",
        "pulseaudio",
        "battery",
        "group/power"
    ],
    "wlr/taskbar": {
        "format": "{icon}",
        "on-click": "activate",
        "on-click-right": "fullscreen",
        "icon-theme": "Papirus-Dark",
        "icon-size": 25,
        "tooltip-format": "{title}"
    },
    "sway/workspaces": {
        "on-click": "activate",
        "format": "{icon} {name}",
        "format-icons": {
            "default": "",
            "1": "",
            "2": "",
            "3": "",
            "4": "",
            "5": "",
            "6": "",
            "7": "",
            "8": "",
            "9": "",
            "active": "\udb85\udcfb",
            "urgent": "\uf06a"
        },
        "persistent_workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": []
        }
    },
    "wlr/workspaces": {
        "on-click": "activate",
        "format": "{icon} {name}",
        "format-icons": {
            "default": "",
            "1": "",
            "2": "",
            "3": "",
            "4": "",
            "5": "",
            "6": "",
            "7": "",
            "8": "",
            "9": "",
            "active": "\udb85\udcfb",
            "urgent": "\uf06a"
        },
        "persistent_workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": []
        }
    },
    "custom/weather": {
        "format": "{}",
        "format-alt": "{alt}: {}",
        "format-alt-click": "click-right",
        "interval": 3600,
        "return-type": "json",
        "exec": "~/.config/hypr/scripts/weather.sh",
        "exec-if": "ping wttr.in -c1"
    },
    "tray": {
        "spacing": 10
    },
    "clock": {
        "tooltip-format": "{calendar}",
        "format": "  {:%H:%M  \udb83\ude18 %a, %d %b %Y}",
        "calendar": {
            "iso8601": true
        }
    },
    "custom/timer": {
        "exec": "/home/luca/.config/waybar/scripts/waybar_timer hook",
        "exec-on-event": false,
        "return-type": "json",
        "format": "{icon} {0}",
        "format-icons": {
            "standby": " STANDBY",
            "running": "\udb82\udd96 RUNNING",
            "paused": "\udb82\udd55 PAUSE"
        },
        "on-click": "/home/luca/.config/waybar/scripts/waybar_timer new 25 'notify-send \"Session finished\"'",
        "on-click-middle": "/home/luca/.config/waybar/scripts/waybar_timer cancel",
        "on-click-right": "/home/luca/.config/waybar/scripts/waybar_timer togglepause",
        "on-scroll-up": "/home/luca/.config/waybar/scripts/waybar_timer increase 60 || /home/luca/.config/waybar/scripts/waybar_timer new 1 'notify-send -a \"Waybar-Timer\" -u critical -t 10000 \"Timer expired!\"'",
        "on-scroll-down": "/home/luca/.config/waybar/scripts/waybar_timer decrease 60"
    },
    "network": {
        "format-wifi": "{icon}",
        "format-icons": [
            "\udb82\udd2f",
            "\udb82\udd1f",
            "\udb82\udd22",
            "\udb82\udd25",
            "\udb82\udd28"
        ],
        "format-ethernet": "\udb80\udc02",
        "format-disconnected": "\udb81\uddaa",
        "format-alt": " {bandwidthUpBytes} \u2191  {bandwidthDownBytes} \u2193",
        "tooltip-format-wifi": "{icon} {essid} \u2014 \u2191 {bandwidthUpBytes} \u2193 {bandwidthDownBytes}",
        "tooltip-format-ethernet": "Ethernet \u2014 \u2191 {bandwidthUpBytes} \u2193 {bandwidthDownBytes}",
        "tooltip-format-disconnected": "Disconnected \u2014 no speed",
        "interval": 1,
        "nospacing": 1,
        "on-click": "nm-connection-editor"
    },
    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-bluetooth": "\udb80\udcb0",
        "nospacing": 1,
        "tooltip-format": "Volume {volume}%",
        "format-muted": "\udb81\udf5f",
        "format-icons": {
            "headphone": "",
            "default": [
                "\udb81\udd80",
                "\udb81\udd7e",
                ""
            ]
        },
        "on-click": "pavucontrol",
        "scroll-step": 1
    },
    "custom/logo": {
        "format": " \uf32a ",
        "tooltip": false,
        "on-click": "cosmic-launcher",
        "on-click-right": "kitty"
    },
    "custom/keyboard": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/.config/hypr/scripts/keyboard.sh",
        "interval": 1
    },
    "custom/media": {
        "format": "  {}",
        "interval": 1,
        "max-length": 50,
        "escape": true,
        "exec": "playerctl metadata --format='{{artist}} : {{title}}'"
    },
    "battery": {
        "format": "{capacity}% {icon}",
        "format-icons": {
            "charging": [
                "\udb82\udc9c",
                "\udb80\udc86",
                "\udb80\udc87",
                "\udb80\udc88",
                "\udb82\udc9d",
                "\udb80\udc89",
                "\udb82\udc9e",
                "\udb80\udc8a",
                "\udb80\udc8b",
                "\udb80\udc85"
            ],
            "default": [
                "\udb80\udc7a",
                "\udb80\udc7b",
                "\udb80\udc7c",
                "\udb80\udc7d",
                "\udb80\udc7e",
                "\udb80\udc7f",
                "\udb80\udc80",
                "\udb80\udc81",
                "\udb80\udc82",
                "\udb80\udc79"
            ]
        },
        "format-full": "",
        "interval": 5,
        "states": {
            "warning": 20,
            "critical": 10
        },
        "tooltip": false,
        "tooltip-format": "{capacity}% \u2014 {time}"
    },
    "custom/power": {
        "format": "\u23fb",
        "tooltip": false,
        "on-click": "systemctl poweroff"
    },
    "custom/poweroff": {
        "format": "\udb81\udc25",
        "tooltip": false,
        "on-click": "systemctl poweroff"
    },
    "custom/reboot": {
        "format": "\udb81\udf09",
        "tooltip": false,
        "on-click": "systemctl reboot"
    },
    "custom/logout": {
        "format": "\udb80\udf43",
        "tooltip": false,
        "on-click": "swaymsg exit"
    },
    "custom/suspend": {
        "format": "\udb82\udd04",
        "tooltip": false,
        "on-click": "systemctl suspend"
    },
    "group/power": {
        "orientation": "horizontal",
        "modules": [
            "custom/power",
            "custom/suspend",
            "custom/logout",
            "custom/reboot",
            "custom/poweroff"
        ]
    }
}